MEMORY
{
    rom(rx)   : ORIGIN = 0x0,       LENGTH = 0x1000000
    ram_a(rw) : ORIGIN = 0x1000000, LENGTH = 0x0800000
    ram_b(rw) : ORIGIN = 0x1800000, LENGTH = 0x0800000
}
PHDRS
{
    text   PT_LOAD FLAGS(5); /* R-X */
    ctors  PT_LOAD FLAGS(6); /* RW- */
    peri   PT_LOAD FLAGS(6); /* RW- */
    data   PT_LOAD FLAGS(6); /* RW- */
    heap   PT_LOAD FLAGS(6); /* RW- */
}
SECTIONS
{
    .boot : { *(.boot) 
        KEEP (*(.boot)) 
    } > rom :text
    .vectors 0xc0 : {
        KEEP (*(.vectors))
    } > rom :text
    .srodata : { *(.srodata*) } > rom :text
    .early_text : { *(.early_text*) } > rom :text
    .text : { *(.text*) } > rom :text
    /* C++ global constructor pointers; walked by __runtime_init.
       (No .fini_array: embedded firmware never exits.) */
    .init_array : {
        . = ALIGN(4);
        __init_array_start = .;
        KEEP (*(SORT_BY_INIT_PRIORITY(.init_array.*)))
        KEEP (*(.init_array))
        __init_array_end = .;
    } > rom :ctors
    .rodata : { *(.rodata*) } > rom :text

    .peri : {
        . = ALIGN(4);
        __peri_data_start__ = .;
        *(.peri_data*)
        . = ALIGN(4);
        __peri_data_end__ = .;
        *(.peri_bss*)
    } > ram_a AT> rom :peri
    __peri_lma = LOADADDR(.peri);

    /* Used for interrupt context */
    .scratch 0x1000200 : {
        . += 0x30;
    } > ram_a :NONE

    .data : { 
        __data_start_unaligned__ = .;
        . = ALIGN(16);
        __data_start__ = .;
        *(.sdata*) *(.data*) 
        . = ALIGN(16);
        __data_end__ = .;
    } > ram_a AT> rom :data
    __data_lma = LOADADDR(.data) + __data_start__ - __data_start_unaligned__;

    .bss (NOLOAD): { 
        . = ALIGN(16);
        __bss_start__ = .;
        *(.sbss*) *(.bss*)
        . = ALIGN(16);
        __bss_end__ = .;
    } > ram_a :data

    .uninitialized_data (NOLOAD): {
        . = ALIGN(16);
        *(.uninitialized_data*)

        /* Interrupt stack */
        . = ALIGN(16);
        . += 0x1000;
        __interrupt_stack_top = .;
    } > ram_a :NONE

    .heap (NOLOAD):
    {
        . = ALIGN(4);
        __HeapStart = .;
        KEEP(*(.heap*))
        __HeapLimit = .;
    } > ram_b :heap

    __global_pointer$ = 0x1000400;
    __StackTop = ORIGIN(ram_a) + LENGTH(ram_a);
    __StackLimit = __StackTop - 0x1000;
    ASSERT(__StackLimit >= __interrupt_stack_top, "region RAM overflowed")
    ASSERT(__HeapLimit >= __HeapStart, "no room for heap in ram_b")
}
